# Local development (never commit .env)
ENVIRONMENT=development
PERSISTENCE_BACKEND=sqlite
DATABASE_PATH=.local/interviews.db
PUBLIC_ORIGIN=http://localhost:8000
BACKEND_URL=http://localhost:8000
# Set a password to disable the local no-password admin/founder preview buttons.
ADMIN_PASSWORD=
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
WORKER_SECRET=

# LiveKit project credentials (same project for API and worker)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Streaming recognition, reasoning, and voice output
STT_PROVIDER=deepgram
# Required only for STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
# Optional separate STT key for STT_PROVIDER=elevenlabs; otherwise reuse ELEVENLABS_API_KEY.
# The STT key needs Speech to Text access; the TTS key needs Text to Speech access.
ELEVENLABS_STT_API_KEY=
# Select the ElevenLabs Voice-ID in the administrator interface.

# Production: ENVIRONMENT=production, PERSISTENCE_BACKEND=firestore,
# HTTPS PUBLIC_ORIGIN, three distinct secrets/password >=32 chars.
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
# On GCP use workload identity/Application Default Credentials, not committed key files.
